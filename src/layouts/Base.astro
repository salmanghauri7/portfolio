---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { GENERAL_INFO } from '../data/site';
import Curtain from '../components/Curtain.astro';
import Preloader from '../components/Preloader.astro';
import Nav from '../components/Nav.astro';
import Cursor from '../components/Cursor.astro';
import ScrollProgress from '../components/ScrollProgress.astro';
import Backdrop from '../components/Backdrop.astro';
import StickyEmail from '../components/StickyEmail.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}
const { title = GENERAL_INFO.name, description = '' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Font cssVariable="--font-anton" preload />
    <Font cssVariable="--font-roboto-flex" />
    <noscript>
      <style>
        .preloader,
        .curtain {
          display: none !important;
        }
      </style>
    </noscript>
  </head>
  <body>
    <Curtain />
    <Preloader />
    <Nav />
    <slot />
    <Footer />
    <Cursor />
    <ScrollProgress />
    <Backdrop />
    <StickyEmail />
    <script>
      import '../lib/motion';
    </script>
  </body>
</html>
