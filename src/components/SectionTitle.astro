---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<div class="section-title">
  <img class="flower" src="/icons/section-flower.svg" alt="" width="25" height="29" />
  <h2>{title}</h2>
</div>

<style>
  .section-title {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 40px;
  }
  .flower {
    width: 25px;
    animation: spin 7s linear infinite; /* global.css kills animations under reduced motion */
  }
  h2 {
    font-size: 20px;
    line-height: 1;
    text-transform: uppercase;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
