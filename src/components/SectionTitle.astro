---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<div class="section-title">
  <h2>{title}</h2>
</div>

<style>
  .section-title {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 40px;
  }
  h2 {
    font-size: 20px;
    line-height: 1;
    text-transform: uppercase;
  }
</style>
