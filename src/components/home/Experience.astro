---
import { MY_EXPERIENCE } from '../../data/site';
import SectionTitle from '../SectionTitle.astro';
---

<section id="my-experience" class="experience">
  <div class="container">
    <SectionTitle title="My Experience" />
    <ol class="timeline">
      <div class="timeline-fill" aria-hidden="true"></div>
      {
        MY_EXPERIENCE.map((job) => (
          <li class="timeline-item">
            <p class="duration">{job.duration}</p>
            <p class="title">{job.title}</p>
            <p class="company">{job.company}</p>
            {job.summary && <p class="summary">{job.summary}</p>}
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .experience {
    padding-block: var(--section);
  }
  .timeline {
    --rail: 40px;
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0 0 0 var(--rail);
  }
  /* rail track + fill share the same box; CSS rest state is fully drawn, JS scales the fill from 0 */
  .timeline::before,
  .timeline-fill {
    content: '';
    position: absolute;
    left: 0;
    top: 10px;
    bottom: 0;
    width: 2px;
    background: var(--border);
  }
  .timeline-fill {
    background: var(--primary);
    transform-origin: top;
  }
  .timeline-item {
    position: relative;
    padding-bottom: 56px;
  }
  .timeline-item:last-child {
    padding-bottom: 0;
  }
  /* node: 12px circle centred on the 2px rail; rest state is lit, JS toggles is-pending */
  .timeline-item::before {
    content: '';
    position: absolute;
    left: calc(-1 * var(--rail) - 5px);
    top: 4px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--primary);
    border: 2px solid var(--primary);
    transition: background 0.3s, border-color 0.3s;
  }
  .timeline-item.is-pending::before {
    background: var(--bg);
    border-color: var(--border);
  }
  .duration {
    font-size: 14px;
    line-height: 20px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted-fg);
  }
  .title {
    font: 400 36px/1 var(--font-anton);
    margin-top: 14px;
    margin-bottom: 10px;
  }
  .company {
    font-size: 20px;
    line-height: 28px;
    color: var(--muted-fg);
  }
  .summary {
    max-width: 520px;
    margin-top: 12px;
    color: var(--muted-fg);
  }

  @media (min-width: 640px) {
    .title {
      font-size: 48px;
    }
  }
  @media (min-width: 768px) {
    .timeline {
      --rail: 56px;
    }
  }
</style>

<script>
  import { gsap, mm } from '../../lib/motion';

  mm.add('(prefers-reduced-motion: no-preference)', () => {
    // Rail fill and node light-up both use the viewport's 60% line: the fill's tip sits exactly
    // there while scrubbing, so a node lights the moment the amber tip reaches it. Change both or neither.
    gsap.from('#my-experience .timeline-fill', {
      scaleY: 0,
      ease: 'none',
      scrollTrigger: { trigger: '#my-experience .timeline', start: 'top 60%', end: 'bottom 60%', scrub: 0.5 },
    });

    document.querySelectorAll<HTMLElement>('#my-experience .timeline-item').forEach((item) => {
      item.classList.add('is-pending');
      gsap.from(item, {
        x: -24,
        autoAlpha: 0,
        duration: 0.6,
        scrollTrigger: {
          trigger: item,
          start: 'top 60%',
          toggleActions: 'play none none reverse',
          onEnter: () => item.classList.remove('is-pending'),
          onLeaveBack: () => item.classList.add('is-pending'),
        },
      });
    });

    gsap
      .timeline({
        scrollTrigger: { trigger: '#my-experience .container', start: 'bottom 50%', end: 'bottom 20%', scrub: 1 },
      })
      .to('#my-experience .container', { y: -150, opacity: 0 });
  });
</script>
