<svg id="cursor" width="27" height="30" viewBox="0 0 27 30" aria-hidden="true">
  <path
    d="M20.0995 11.0797L3.72518 1.13204C2.28687 0.258253 0.478228 1.44326 0.704999 3.11083L3.28667 22.0953C3.58333 24.2768 7.33319 24.6415 8.3792 22.7043C9.5038 20.6215 10.8639 18.7382 12.43 17.7122C13.996 16.6861 16.2658 16.1911 18.6244 15.9918C20.8181 15.8063 21.9811 12.2227 20.0995 11.0797Z"
  ></path>
</svg>

<style>
  #cursor {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 50;
    pointer-events: none;
    opacity: 0;
    display: none;
    fill: var(--fg);
    stroke: hsl(0 0% 13% / 0.5);
    stroke-width: 2;
  }
  @media (min-width: 768px) {
    #cursor {
      display: block;
    }
  }
</style>

<script>
  import { gsap, mm } from '../lib/motion';

  // Kept quirk: no -50% offset, the SVG's top-left corner sits at the pointer. No hover scaling.
  mm.add('(prefers-reduced-motion: no-preference) and (pointer: fine) and (min-width: 768px)', () => {
    const cursor = document.getElementById('cursor')!;
    const move = (e: MouseEvent) =>
      gsap.to(cursor, { x: e.clientX, y: e.clientY, ease: 'power2.out', duration: 0.25, opacity: 1 });
    addEventListener('mousemove', move);
    return () => removeEventListener('mousemove', move);
  });
</script>
