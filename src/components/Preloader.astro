---
import { GENERAL_INFO } from '../data/site';
---

<div class="preloader">
  {Array.from({ length: 10 }, () => <div class="preloader-item" />)}
  <p class="name-text" aria-label={GENERAL_INFO.preloaderName}>
    {GENERAL_INFO.preloaderName.split('').map((letter) => <span aria-hidden="true">{letter}</span>)}
  </p>
</div>

<style>
  .preloader {
    position: fixed;
    inset: 0;
    z-index: 6;
    display: flex;
  }
  .preloader-item {
    height: 100%;
    width: 10%;
    background: #000;
  }
  .name-text {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    overflow: hidden;
    font: 400 20vw/1 var(--font-anton);
    color: var(--fg);
  }
  .name-text span {
    display: inline-block;
    transform: translateY(100%);
  }
  @media (min-width: 1024px) {
    .name-text {
      font-size: 200px;
    }
  }
</style>

<script>
  import { gsap, reduce } from '../lib/motion';

  const preloader = document.querySelector<HTMLElement>('.preloader')!;
  // sessionStorage can throw (privacy modes); if it does, just run the preloader.
  let seen = false;
  try {
    seen = !!sessionStorage.getItem('preloaded');
    sessionStorage.setItem('preloaded', '1');
  } catch {}

  if (reduce || seen) {
    preloader.remove();
  } else {
    gsap
      .timeline({ defaults: { ease: 'power1.inOut' }, onComplete: () => preloader.remove() })
      .to('.name-text span', { y: 0, stagger: 0.05, duration: 0.2 })
      .to('.preloader-item', { y: '100%', delay: 1, duration: 0.5, stagger: 0.1 })
      .to('.name-text span', { autoAlpha: 0 }, '<0.5')
      .to(preloader, { autoAlpha: 0 }, '<1');
  }
</script>
