<div class="progress" aria-hidden="true">
  <div class="progress-fill"></div>
</div>

<style>
  .progress {
    position: fixed;
    top: 50svh;
    right: 2%;
    z-index: 1;
    transform: translateY(-50%);
    width: 6px;
    height: 100px;
    border-radius: 9999px;
    background: var(--bg-light);
    overflow: hidden;
  }
  .progress-fill {
    width: 100%;
    height: 100%;
    border-radius: 9999px;
    background: var(--primary);
    transform: translateY(-100%);
  }
</style>

<script>
  import { lenis } from '../lib/motion';

  const fill = document.querySelector<HTMLElement>('.progress-fill')!;
  const set = (progress: number) => {
    fill.style.transform = `translateY(${-(100 - progress * 100)}%)`;
  };

  if (lenis) {
    lenis.on('scroll', (e) => set(e.progress));
  } else {
    const onScroll = () => {
      const max = document.documentElement.scrollHeight - innerHeight;
      set(max > 0 ? scrollY / max : 0);
    };
    addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>
